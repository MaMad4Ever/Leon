{
  "manifest_version": 3,
  "name": "Leon",
  "version": "0.1.0",
  "description": "Web exposure scanner for security research.",
  "browser_specific_settings": {
    "gecko": {
      "id": "leon@mamad4ever",
      "strict_min_version": "115.0"
    }
  },
  "action": {
    "default_title": "Leon",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],

  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}